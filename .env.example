# Runtime
NODE_ENV=production
APP_NAME=VaultLink Bot
APP_PUBLIC_URL=https://example.com

# Telegram
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_DEEP_LINK_BASE=https://t.me

# Main bot — get from @BotFather, paste raw token
MAIN_BOT_TOKEN=

# Database — relative path resolved from project root
DATABASE_PATH=./data/vaultlink.sqlite

# 32 bytes of entropy, base64-encoded. Generate via: pnpm generate:key
TOKEN_ENCRYPTION_KEY=

# Comma-separated Telegram numeric user IDs that are super-admins
ADMIN_IDS=

# UX
DEFAULT_LOCALE=th
LOG_LEVEL=info

# Share code length (alphabet excludes 0/1/I/L/O for readability)
CODE_LENGTH=12

# Upload limits
MAX_FILE_SIZE_MB=50
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.scr,.ps1,.msi,.apk

# Per-user rate limits
UPLOAD_LIMIT_PER_HOUR=20
DOWNLOAD_LIMIT_PER_HOUR=100
ADD_BOT_LIMIT_PER_DAY=5
REPORT_LIMIT_PER_HOUR=10

# Moderation
AUTO_LOCK_REPORT_THRESHOLD=3

# 0 = no expiry, >0 = days
DEFAULT_FILE_EXPIRY_DAYS=0

# How updates reach the bot:
#   long_poll  — bot polls Telegram (default; works behind any NAT, no public HTTPS)
#   webhook    — Telegram POSTs to a public HTTPS endpoint we expose
TELEGRAM_UPDATE_MODE=long_poll

# Webhook settings — only consulted when TELEGRAM_UPDATE_MODE=webhook.
# WEBHOOK_BASE_URL is the public HTTPS URL of *this* process (or its proxy).
# Each managed bot is registered at <WEBHOOK_BASE_URL>/webhook/<telegram_bot_id>.
# Telegram only allows ports 80, 88, 443, or 8443 by default; if you reverse-
# proxy on 443 you can bind any local port here.
WEBHOOK_BASE_URL=
WEBHOOK_PORT=8443
# Optional. If set, Telegram echoes this back as the X-Telegram-Bot-Api-Secret-Token
# header on every POST so the listener can reject forged calls. Alphabet:
# A-Z a-z 0-9 _ -, length 1-256.
WEBHOOK_SECRET_TOKEN=

# Long-polling allowed update list (used in long_poll mode).
BOT_POLLING_ALLOWED_UPDATES=message,callback_query

# Feature flags
ENABLE_PASSWORD_PROTECTION=true
ENABLE_FILE_EXPIRY=true
ENABLE_REPORTS=true
ENABLE_CHILD_BOTS=true
ENABLE_ADMIN_BROADCAST=false

# Optional health HTTP server (off by default)
HEALTH_SERVER_ENABLED=false
HEALTH_SERVER_HOST=127.0.0.1
HEALTH_SERVER_PORT=8080

# Telegram Mini App (the only allowed "web UI" — runs inside Telegram).
# When ENABLE_MINI_APP=true the JSON API server starts and bot commands
# /dashboard, /files, /bots, /admin_dashboard show a WebApp button.
# Auth is Telegram initData HMAC — there is no browser login.
ENABLE_MINI_APP=false
MINI_APP_URL=
MINI_APP_API_BASE_URL=
MINI_APP_ALLOWED_ORIGINS=
MINI_APP_INITDATA_MAX_AGE_SECONDS=86400

# Collections / media bundles — one share code can resolve to many items.
ENABLE_COLLECTIONS=true
COLLECTION_PAGE_SIZE=10
COLLECTION_DRAFT_TTL_MINUTES=60
COLLECTION_SEND_DELAY_MS=700
MAX_COLLECTION_ITEMS=100
MAX_BULK_SEND_ITEMS=50

# Telegram API limits — defaults reflect the current Bot API documented limits.
# Re-tune these (no code changes) if Telegram updates the rules.
TELEGRAM_GLOBAL_RATE_LIMIT_PER_SEC=30
TELEGRAM_PER_CHAT_RATE_LIMIT_PER_SEC=1
TELEGRAM_PER_GROUP_RATE_LIMIT_PER_MIN=20
TELEGRAM_MEDIA_GROUP_MAX_ITEMS=10
TELEGRAM_MESSAGE_MAX_LENGTH=4096
TELEGRAM_INLINE_KEYBOARD_MAX_BUTTONS=100
TELEGRAM_INLINE_KEYBOARD_MAX_ROW_WIDTH=8
TELEGRAM_CALLBACK_DATA_MAX_BYTES=64
TELEGRAM_LONG_POLL_TIMEOUT_SECONDS=50

# Auto-retry behavior on Telegram 429 responses (honors retry_after).
TELEGRAM_AUTORETRY_MAX_ATTEMPTS=5
TELEGRAM_AUTORETRY_MAX_DELAY_SECONDS=60

# Concurrency: per-user updates serialize; different users run in parallel.
# RUNNER_CONCURRENCY caps how many in-flight handlers run at once.
RUNNER_CONCURRENCY=200

# Child bot start fan-out (avoids hammering Telegram during cold start).
CHILD_BOT_MAX_PARALLEL_STARTS=16

# Delay between admin broadcast messages, in milliseconds.
BROADCAST_DELAY_MS=50

# ─────────────────────────────────────────────────────────────────────────────
# Credit system (Wave 9) — fully dynamic, every value can be overridden at
# runtime via /admin → Credits or `/admin_credit_set <key> <value>`. The
# values below are only the BOOT defaults — they kick in when the matching
# settings-table row is missing, so flipping a toggle in chat is enough to
# change behaviour without a redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Production pricing model (anchor: 1 USDT = 33 THB) ────────────────────
#
# Goal: a single number — "credits" — drives every paid action, with both
# Stars and USDT priced consistently. A "credit" is the bot's internal unit
# of work; one file open costs 1 credit by default.
#
#   1 USDT          = 100 credits        (CRYPTO_TRON_USDT_RATE / TON_USDT)
#   1 USDT          = 33 THB             (the operator's chosen anchor)
#   ⇒ 1 credit      ≈ 0.33 THB           (≈ $0.01)
#   ⇒ 100 credits   = 1 USDT = 33 THB
#
# Telegram Stars retail at roughly 0.5 THB/Star → 66 Stars ≈ 33 THB ≈ 1 USDT.
# At 1 USDT = 100 credits, that's ≈ 1.5 credits/Star at parity. The default
# Stars packages in code (DEFAULT_TOPUP_PACKAGES) deliberately give a small
# volume bonus on top of this:
#
#   10 Stars  → ~15 credits   (parity)
#   50 Stars  → ~80 credits   (~+8% bonus)
#   100 Stars → ~170 credits  (~+15% bonus)
#
# Adjust at runtime via:  /admin_credit_packages_set 10:15,50:80,100:170
# (or open the Mini App admin panel). Re-read this block whenever the
# THB-USDT exchange rate moves materially — a 10% shift in the anchor
# means /admin_credits → re-tune Stars packages, that's it.
#
# 1 TON ≈ $3.50 USD ≈ 115 THB at recent prices → 350 credits per TON.
# Re-tune CRYPTO_TON_NATIVE_RATE whenever TON moves; volatile asset.
# ───────────────────────────────────────────────────────────────────────────

# Master switch. When false the entire credit system is invisible — no
# charges, no balance UI, no signup bonus, no referral hints. Flip to true
# in production once Stars / Crypto rails are configured.
ENABLE_CREDITS=true

# Credits granted to each user on their first interaction after the system
# was enabled. Set to 0 to disable the welcome bonus.
CREDITS_SIGNUP_BONUS=10

# Default cost (in credits) for each redemption action. Per-action keys
# can also be set in the settings table:
#   credits.cost_decode             — single-file open
#   credits.cost_collection_open    — collection page-1
#   credits.cost_collection_send    — bulk "send all remaining"
# Plus per-file-type overrides via credits.cost_decode.<filetype>
# (e.g. credits.cost_decode.video=3) and a per-item bulk surcharge via
# credits.cost_collection_per_item. All editable from /admin_credit_set.
CREDITS_COST_DECODE=1
CREDITS_COST_COLLECTION_OPEN=1
CREDITS_COST_COLLECTION_SEND=1

# Referral rewards — creator earns N credits each time someone else opens
# their code. Set _ENABLED=false to turn off entirely; set REWARD=0 for an
# implicit off. DAILY_CAP limits how much one creator can earn per UTC
# day (0 = unlimited).
CREDITS_REFERRAL_ENABLED=true
CREDITS_REFERRAL_REWARD=1
CREDITS_REFERRAL_DAILY_CAP=200

# Anti-farming defense (Wave 9.3) — gates collusion attacks where one
# attacker creates N codes and asks an accomplice to redeem them all.
# All thresholds are runtime-overridable from /admin → Credits.
#
#   PAIR_LIFETIME_CAP  — same (creator, redeemer) pair can only generate
#                        this many referral rewards EVER. Dropbox-style.
#                        Set 0 to disable (NOT recommended).
#   PAIR_WINDOW_*      — burst defense: same pair can only generate
#                        WINDOW_MAX rewards within WINDOW_MINUTES.
#                        Set MINUTES=0 to disable.
#   REDEEMER_MIN_AGE_MINUTES — brand-new accounts must mature this many
#                              minutes before opening a code triggers a
#                              referral reward. Defeats throwaway alts.
#                              Set 0 to disable.
CREDITS_REFERRAL_PAIR_LIFETIME_CAP=5
CREDITS_REFERRAL_PAIR_WINDOW_MINUTES=15
CREDITS_REFERRAL_PAIR_WINDOW_MAX=2
CREDITS_REFERRAL_REDEEMER_MIN_AGE_MINUTES=30

# Telegram Stars topup. Packages live in the settings table key
# `credits.topup_packages`. The hardcoded defaults still ship with a generous
# rate — re-tune to the anchor (1 Star ≈ 1.5 credits at parity) via:
#   /admin_credit_packages_set 10:15,50:80,100:170
CREDITS_TOPUP_ENABLED=true

# When true, opening your own code is free (recommended). Admins are
# always free unless explicitly turned off.
CREDITS_BYPASS_FOR_OWNER=true
CREDITS_BYPASS_FOR_ADMIN=true

# ─────────────────────────────────────────────────────────────────────────────
# Self-custodial crypto top-up (Wave 9.1) — adds USDT-TRC20 / TON / USDT-TON
# as alternatives to Telegram Stars. The bot is watch-only: it stores the
# RECEIVING address in the settings table and verifies payments against
# public RPC endpoints (trongrid + toncenter). Private keys never touch
# the server.
#
# Per-chain setup at runtime via /admin_crypto:
#   1. /admin_crypto_address tron-usdt <your TRON receiving address>
#   2. (optional) /admin_crypto_apikey tron-usdt <trongrid api key>
#   3. /admin_crypto       → tap "Toggle tron-usdt"
#   4. /admin_credit_set credits.crypto.enabled true   (master switch)
#
# All operator-tunable values below are BOOT defaults; settings-table
# overrides win at runtime.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch for the crypto top-up flow. When false the user-facing
# button never appears.
ENABLE_CRYPTO_TOPUP=true

# How long an invoice stays open before auto-expiry (minutes). The user
# has this long to pay; the worker auto-credits once the on-chain transfer
# is detected and confirmations clear. Wave 9.3 default = 60 min.
CRYPTO_INVOICE_TTL_MINUTES=60

# Worker poll interval. Lower = faster confirmation, more RPC traffic.
# Aligned with the Mini App's react-query refetch interval (15s).
CRYPTO_POLL_INTERVAL_SECONDS=15

# Amount-match tolerance in basis points (10000 bps = 100%). 0 means
# strict ">=" matching; 100 lets users underpay by up to 1% before the
# invoice rejects. Stays at 0 by default — Wave 9.3 attributes payments
# via unique-amount suffix, so any underpayment IS a different invoice.
CRYPTO_AMOUNT_TOLERANCE_BPS=0

# Wave 9.3 — per-network RPC endpoints. Empty = adapter disabled. Bot is
# watch-only: never holds keys, only reads logs / receipts.
#   * TRON: https://api.trongrid.io (free tier; key via /admin_crypto_apikey)
#   * BSC : public dataseed (https://bsc-dataseed.binance.org) or your node
#   * ETH : Infura/Alchemy/QuickNode/Erigon endpoint with archival access
#           good enough to call eth_getLogs across the invoice TTL window
#   * TON : https://toncenter.com/api/v2 (free tier; api key recommended)
CRYPTO_TRON_RPC_URL=https://api.trongrid.io
CRYPTO_BSC_RPC_URL=https://bsc-dataseed.binance.org
CRYPTO_ETH_RPC_URL=
CRYPTO_TON_RPC_URL=https://toncenter.com/api/v2

# Per-(chain, token) confirmation thresholds. Stablecoin top-up at retail
# scale (≤ $5 000 cap) tolerates fast finality:
#   * TRX : 1 conf (~3s) — SR finality at block 1 is industry-accepted
#   * BSC : 15 conf (~45s) — PoSA, no hard finality; 15 = exchange standard
#   * ETH : 12 conf (~2.4 min) — PoS, 12 conf is exchange standard for stables
#   * TON : 1 conf (~5s) — masterchain finality
# Operator can raise per chain via /admin_credit_set credits.crypto.<id>.confirmations.
CRYPTO_TRON_USDT_CONFIRMATIONS=1
CRYPTO_TRON_USDC_CONFIRMATIONS=1
CRYPTO_BSC_USDT_CONFIRMATIONS=15
CRYPTO_BSC_USDC_CONFIRMATIONS=15
CRYPTO_ETH_USDT_CONFIRMATIONS=12
CRYPTO_ETH_USDC_CONFIRMATIONS=12
CRYPTO_TON_NATIVE_CONFIRMATIONS=1
CRYPTO_TON_USDT_CONFIRMATIONS=1
CRYPTO_TON_USDC_CONFIRMATIONS=1

# Credits granted per 1 whole unit. USDT/USDC peg to $1 → uniform 100
# credits/unit. CRYPTO_TON_NATIVE_RATE retained for legacy invoices only;
# new TON top-ups must use the USDT/USDC jetton chain ids.
CRYPTO_TRON_USDT_RATE=100
CRYPTO_TRON_USDC_RATE=100
CRYPTO_BSC_USDT_RATE=100
CRYPTO_BSC_USDC_RATE=100
CRYPTO_ETH_USDT_RATE=100
CRYPTO_ETH_USDC_RATE=100
CRYPTO_TON_NATIVE_RATE=350
CRYPTO_TON_USDT_RATE=100
CRYPTO_TON_USDC_RATE=100

# Wave 9.3 abuse defenses.
#   * Cap concurrent active invoices per user — prevents enumeration + DoS
#   * Rate-limit createInvoice — same envelope as Stars invoice rate limit
#   * Dust threshold: worker ignores incoming transfers below this USD value
#     (USDT/USDC peg $1) so attackers can't fill the match queue with sub-cent
#     transfers. 0 = no dust filter.
CRYPTO_MAX_ACTIVE_INVOICES_PER_USER=3
CRYPTO_INVOICE_RATELIMIT_PER_MIN=5
CRYPTO_DUST_THRESHOLD_USD=0

# ---------------------------------------------------------------------------
# Stars refund defense (Wave 9.2). Telegram lets a buyer dispute a Stars
# payment for up to 14 days; on approval Telegram delivers a
# `refunded_payment` service message. The defense has four layers:
#
#   1. CLAWBACK   — the original `topup` ledger row is reversed atomically.
#                   The cached balance can go negative; the existing overdraft
#                   check then auto-blocks further spending.
#   2. TIME LOCK  — `users.spend_locked_until` is set to
#                   `now + (stars * STARS_REFUND_LOCK_SECONDS_PER_STAR)`
#                   capped at STARS_REFUND_LOCK_MAX_SECONDS.
#   3. HARD BAN   — `STARS_REFUND_HARD_BAN_THRESHOLD` refund events inside
#                   `STARS_REFUND_HARD_BAN_WINDOW_DAYS` flips `is_banned`.
#   4. ADMIN OVR  — founder-only Mini App endpoints clear the lock and
#                   (optionally) write off the deficit for genuine refunds.
#
# Defaults: 3600 s/Star → 100 Stars locks for ~4.17 days; capped at 30 days;
# three refunds in 30 days = permanent ban.
STARS_REFUND_LOCK_SECONDS_PER_STAR=3600
STARS_REFUND_LOCK_MAX_SECONDS=2592000
STARS_REFUND_HARD_BAN_THRESHOLD=3
STARS_REFUND_HARD_BAN_WINDOW_DAYS=30

# Per-user rate limit for the Mini App's `POST /credits/stars/invoice`
# endpoint. Without a cap a hostile client could spam Telegram with invoice
# creations and burn the bot's global API quota.
MINI_APP_STARS_INVOICE_RATELIMIT_PER_MIN=5
