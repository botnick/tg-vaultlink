# Runtime
NODE_ENV=production
APP_NAME=VaultLink Bot
APP_PUBLIC_URL=https://example.com

# Telegram
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_DEEP_LINK_BASE=https://t.me

# Main bot — get from @BotFather, paste raw token
MAIN_BOT_TOKEN=

# Database — relative path resolved from project root
DATABASE_PATH=./data/vaultlink.sqlite

# 32 bytes of entropy, base64-encoded. Generate via: pnpm generate:key
TOKEN_ENCRYPTION_KEY=

# Comma-separated Telegram numeric user IDs that are super-admins
ADMIN_IDS=

# UX
DEFAULT_LOCALE=th
LOG_LEVEL=info

# Share code length (alphabet excludes 0/1/I/L/O for readability)
CODE_LENGTH=12

# Upload limits
MAX_FILE_SIZE_MB=50
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.scr,.ps1,.msi,.apk

# Per-user rate limits
UPLOAD_LIMIT_PER_HOUR=20
DOWNLOAD_LIMIT_PER_HOUR=100
ADD_BOT_LIMIT_PER_DAY=5
REPORT_LIMIT_PER_HOUR=10

# Moderation
AUTO_LOCK_REPORT_THRESHOLD=3

# 0 = no expiry, >0 = days
DEFAULT_FILE_EXPIRY_DAYS=0

# How updates reach the bot:
#   long_poll  — bot polls Telegram (default; works behind any NAT, no public HTTPS)
#   webhook    — Telegram POSTs to a public HTTPS endpoint we expose
TELEGRAM_UPDATE_MODE=long_poll

# Webhook settings — only consulted when TELEGRAM_UPDATE_MODE=webhook.
# WEBHOOK_BASE_URL is the public HTTPS URL of *this* process (or its proxy).
# Each managed bot is registered at <WEBHOOK_BASE_URL>/webhook/<telegram_bot_id>.
# Telegram only allows ports 80, 88, 443, or 8443 by default; if you reverse-
# proxy on 443 you can bind any local port here.
WEBHOOK_BASE_URL=
WEBHOOK_PORT=8443
# Optional. If set, Telegram echoes this back as the X-Telegram-Bot-Api-Secret-Token
# header on every POST so the listener can reject forged calls. Alphabet:
# A-Z a-z 0-9 _ -, length 1-256.
WEBHOOK_SECRET_TOKEN=

# Long-polling allowed update list (used in long_poll mode).
BOT_POLLING_ALLOWED_UPDATES=message,callback_query

# Feature flags
ENABLE_PASSWORD_PROTECTION=true
ENABLE_FILE_EXPIRY=true
ENABLE_REPORTS=true
ENABLE_CHILD_BOTS=true
ENABLE_ADMIN_BROADCAST=false

# Optional health HTTP server (off by default)
HEALTH_SERVER_ENABLED=false
HEALTH_SERVER_HOST=127.0.0.1
HEALTH_SERVER_PORT=8080

# Telegram Mini App (the only allowed "web UI" — runs inside Telegram).
# When ENABLE_MINI_APP=true the JSON API server starts and bot commands
# /dashboard, /files, /bots, /admin_dashboard show a WebApp button.
# Auth is Telegram initData HMAC — there is no browser login.
ENABLE_MINI_APP=false
MINI_APP_URL=
MINI_APP_API_BASE_URL=
MINI_APP_ALLOWED_ORIGINS=
MINI_APP_INITDATA_MAX_AGE_SECONDS=86400

# Collections / media bundles — one share code can resolve to many items.
ENABLE_COLLECTIONS=true
COLLECTION_PAGE_SIZE=10
COLLECTION_DRAFT_TTL_MINUTES=60
COLLECTION_SEND_DELAY_MS=700
MAX_COLLECTION_ITEMS=100
MAX_BULK_SEND_ITEMS=50

# Telegram API limits — defaults reflect the current Bot API documented limits.
# Re-tune these (no code changes) if Telegram updates the rules.
TELEGRAM_GLOBAL_RATE_LIMIT_PER_SEC=30
TELEGRAM_PER_CHAT_RATE_LIMIT_PER_SEC=1
TELEGRAM_PER_GROUP_RATE_LIMIT_PER_MIN=20
TELEGRAM_MEDIA_GROUP_MAX_ITEMS=10
TELEGRAM_MESSAGE_MAX_LENGTH=4096
TELEGRAM_INLINE_KEYBOARD_MAX_BUTTONS=100
TELEGRAM_INLINE_KEYBOARD_MAX_ROW_WIDTH=8
TELEGRAM_CALLBACK_DATA_MAX_BYTES=64
TELEGRAM_LONG_POLL_TIMEOUT_SECONDS=50

# Auto-retry behavior on Telegram 429 responses (honors retry_after).
TELEGRAM_AUTORETRY_MAX_ATTEMPTS=5
TELEGRAM_AUTORETRY_MAX_DELAY_SECONDS=60

# Concurrency: per-user updates serialize; different users run in parallel.
# RUNNER_CONCURRENCY caps how many in-flight handlers run at once.
RUNNER_CONCURRENCY=200

# Child bot start fan-out (avoids hammering Telegram during cold start).
CHILD_BOT_MAX_PARALLEL_STARTS=16

# Delay between admin broadcast messages, in milliseconds.
BROADCAST_DELAY_MS=50
